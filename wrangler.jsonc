// The public copy of Slate: public/ as static files. Boards stay on the visitor's computer (see public/folder.js).
// `npx wrangler deploy` first packs the committed code as public/slate.tar.gz, which install.sh downloads,
// so the site, the installer and the code always come from the same commit. Commit before deploying.
{
  "name": "slate",
  "compatibility_date": "2026-11-18",
  "build": { "command": "git archive --format=tar.gz -o public/slate.tar.gz HEAD" },
  "assets": { "directory": "./public" },
  "routes": [{ "pattern": "slate.appusta.com", "custom_domain": true }]
}
